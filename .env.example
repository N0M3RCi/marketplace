# ============================================
# Railway deployment environment variables
# ============================================

# PostgreSQL connection string (REQUIRED for Railway)
# Railway auto-injects this when you add a PostgreSQL plugin
DATABASE_URL=postgresql://user:password@host:5432/marketplace

# JWT signing secret (RECOMMENDED — has secure fallback for dev)
# Generate with: openssl rand -hex 32
JWT_SECRET=your-production-jwt-secret-change-this
